{
  // Codespace léger : sert l'agenda sur le port 8080 et l'ouvre dans le navigateur.
  "name": "Agenda",
  "image": "mcr.microsoft.com/devcontainers/python:3-bookworm",
  "postAttachCommand": "python3 -m http.server 8080",
  "forwardPorts": [8080],
  "portsAttributes": {
    "8080": { "label": "Agenda", "onAutoForward": "openBrowser" }
  }
}
